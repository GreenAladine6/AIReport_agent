# Gemini is required unless USE_MOCK=1
GEMINI_API_KEY=
USE_MOCK=0

# PostgreSQL/pgvector connection used for reports and conversations
DATABASE_URL=postgresql://aireport:change-this-local-password@localhost:5432/aireport

# Optional local Chroma persistence settings
CHROMA_PERSIST_DIR=.chromadb
CHROMA_COLLECTION=report_chunks
