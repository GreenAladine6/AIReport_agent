# Docker Compose project settings (used from the repository root)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=green2690
POSTGRES_DB=aireport_db

# Backend authentication. Generate a unique random value for real deployments.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Required for the chatbot unless USE_MOCK=1
GEMINI_API_KEY=
USE_MOCK=0
CHROMA_COLLECTION=report_chunks

# Required to run the multiagent CLI job
GITHUB_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-coder
MAX_FILES_TO_FETCH=20
BATCH_SIZE=5
CACHE_TTL=300
CONFIDENCE_THRESHOLD=0.6
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# Optional settings used by backend/routers/chatbot.py
JIRA_DOMAIN=your-domain.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=

# Browser-visible backend URL embedded into the frontend build
VITE_API_URL=http://127.0.0.1:8000
