FROM python:3.11-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app:/app/chatbot
COPY chatbot/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY chatbot/ /app/
EXPOSE 8000
CMD ["uvicorn", "api.routes:app", "--host", "0.0.0.0", "--port", "8000"]
