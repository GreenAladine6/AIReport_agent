# GitHub access and DeepSeek analysis are required by the CLI.
GITHUB_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-coder

# Ollama is optional; the local client falls back if it cannot connect.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional workflow tuning
MAX_FILES_TO_FETCH=20
BATCH_SIZE=5
CACHE_TTL=300
CONFIDENCE_THRESHOLD=0.6

# Used when the report writer saves output to PostgreSQL
DATABASE_URL=postgresql://aireport:change-this-local-password@localhost:5432/aireport
